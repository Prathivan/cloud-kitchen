# Copy this file to ".env" (same folder as manage.py) and fill in real
# values. ".env" itself should never be committed to version control.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Currently running on SQLite (no server needed) so this isn't blocking
# anything right now. When you're ready to move to Postgres: install
# Postgres, create the database/user (see README.md's "Database setup"
# section), uncomment psycopg2-binary in requirements.txt, reinstall,
# then set DB_ENGINE=postgres and fill in the values below.
DB_ENGINE=sqlite
# DB_NAME=butterfly_cloud_kitchen
# DB_USER=butterfly
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
