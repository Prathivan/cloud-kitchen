# Copy this file to ".env" (same folder as manage.py) and fill in real
# values. ".env" itself should never be committed to version control.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# On Render specifically, you don't need to set these two at all --
# config/settings.py automatically adds Render's own hostname using
# RENDER_EXTERNAL_HOSTNAME, which Render injects for you. Only set
# these manually for a custom domain, or other hosts:
# ALLOWED_HOSTS=localhost,127.0.0.1,butterfly-cloud-kitchen.onrender.com
# CSRF_TRUSTED_ORIGINS=https://butterfly-cloud-kitchen.onrender.com

# --- Database ---
# Currently running on SQLite (no server needed) so this isn't blocking
# anything right now. Two ways to switch to Postgres, no code changes
# either way:
#   (a) Set DATABASE_URL alone -- e.g. on Render, linking a Postgres
#       database to this service injects this automatically (see
#       render.yaml). This is the easiest path and needs nothing else
#       below.
#   (b) Set DB_ENGINE=postgres plus the individual DB_* vars below --
#       for a local Postgres install (see README.md's "Database setup"
#       section for the full walkthrough).
# DATABASE_URL=postgres://user:password@host:port/dbname
DB_ENGINE=sqlite
# DB_NAME=butterfly_cloud_kitchen
# DB_USER=butterfly
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# --- First admin account, without needing terminal/Shell access ---
# Only needed on hosts without a Shell tab (e.g. Render's free/Hobby
# plan) -- see README.md's "Deploying to Render" section. Locally, just
# run `python manage.py createsuperuser` instead and leave these unset.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me

# --- Signup mobile OTP (SMS / WhatsApp) ---
# Currently unset, so OTP codes are only printed/logged to your
# runserver console -- nothing is actually sent (see
# accounts/otp_service.py). Once you've signed up with MSG91,
# completed DLT registration for SMS, and got a WhatsApp OTP template
# approved, uncomment and fill in the values below.
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=change-me
# MSG91_SMS_SENDER_ID=change-me
# MSG91_SMS_DLT_TEMPLATE_ID=change-me
# MSG91_SMS_TEMPLATE=Your Butterfly Cloud Kitchen verification code is {otp}. Valid for 5 minutes.
# MSG91_WHATSAPP_INTEGRATED_NUMBER=919876543210
# MSG91_WHATSAPP_TEMPLATE_NAME=change-me
# MSG91_WHATSAPP_NAMESPACE=change-me
# MSG91_WHATSAPP_LANGUAGE=en

# --- Google Maps (delivery address picker) ---
# Used by templates/delivery_address_form.html for location search,
# the draggable pin, and reverse geocoding. Get a key from
# https://console.cloud.google.com/google/maps-apis -- enable the
# "Maps JavaScript API", "Places API", and "Geocoding API" for it.
# Leave unset during development: the address form still works with
# manual text entry, just without the map/search.
# GOOGLE_MAPS_API_KEY=change-me
