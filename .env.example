# Copy this file to ".env" (same folder as manage.py) and fill in real
# values. ".env" itself should never be committed to version control.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# When deployed (e.g. on Render), add your real domain(s), comma-separated:
# ALLOWED_HOSTS=localhost,127.0.0.1,butterfly-cloud-kitchen.onrender.com
# CSRF_TRUSTED_ORIGINS=https://butterfly-cloud-kitchen.onrender.com

# --- Database ---
# Currently running on SQLite (no server needed) so this isn't blocking
# anything right now. When you're ready to move to Postgres: install
# Postgres, create the database/user (see README.md's "Database setup"
# section), uncomment psycopg2-binary in requirements.txt, reinstall,
# then set DB_ENGINE=postgres and fill in the values below.
DB_ENGINE=sqlite
# DB_NAME=butterfly_cloud_kitchen
# DB_USER=butterfly
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# --- Signup mobile OTP (SMS / WhatsApp) ---
# Currently unset, so OTP codes are only printed/logged to your
# runserver console -- nothing is actually sent (see
# accounts/otp_service.py). Once you've signed up with MSG91,
# completed DLT registration for SMS, and got a WhatsApp OTP template
# approved, uncomment and fill in the values below.
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=change-me
# MSG91_SMS_SENDER_ID=change-me
# MSG91_SMS_DLT_TEMPLATE_ID=change-me
# MSG91_SMS_TEMPLATE=Your Butterfly Cloud Kitchen verification code is {otp}. Valid for 5 minutes.
# MSG91_WHATSAPP_INTEGRATED_NUMBER=919876543210
# MSG91_WHATSAPP_TEMPLATE_NAME=change-me
# MSG91_WHATSAPP_NAMESPACE=change-me
# MSG91_WHATSAPP_LANGUAGE=en
